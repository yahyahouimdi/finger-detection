# Copy this file to ".env" and change the values for your setup.

# ---- MQTT broker -------------------------------------------------------
# IP address of the computer running the MQTT broker (Mosquitto).
# Find it with "ipconfig" (Windows) -> IPv4 Address.
MQTT_HOST=192.168.1.197
MQTT_PORT=1883
# Must be the same topic as MQTT_TOPIC in esp32/hand_leds/secrets.h
MQTT_TOPIC=hand/gesture
MQTT_CLIENT_ID=finger-detector-pc
# Leave empty if your broker allows anonymous connections.
MQTT_USERNAME=
MQTT_PASSWORD=

# ---- Camera -------------------------------------------------------------
# 0 = default webcam, 1 = second camera, ...
CAMERA_INDEX=0
# true = show the video window, false = run without a window
SHOW_PREVIEW=true

# ---- Hand detection -----------------------------------------------------
# Downloaded automatically on the first run.
MODEL_PATH=models/hand_landmarker.task
# 0.0 - 1.0: higher = fewer false detections, but may lose the hand more often.
DETECTION_CONFIDENCE=0.7
TRACKING_CONFIDENCE=0.7
# A new finger state must be seen this many frames in a row before it is sent.
# 1 = fastest reaction, 2-3 = less flickering.
STABLE_FRAMES=2
